<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== HEADER ===== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_red"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="48dp">

            <View
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/bg_circle_deco"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="-40dp"
                android:layout_marginEnd="-40dp"/>

            <!-- Top bar -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/btnBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_white_alpha"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">
                </LinearLayout>
                <View
                    android:layout_width="36dp"
                    android:layout_height="36dp"/>
            </LinearLayout>

            <!-- Ikon + subjudul -->
            <LinearLayout
                android:id="@+id/iconSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_below="@id/topBar"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_icon_white_alpha"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/cuti"
                        app:tint="#FFFFFF"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Isi formulir pengajuan cuti di bawah ini"
                    android:textColor="#FFCCCC"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

        </RelativeLayout>

        <!-- ===== FORM CARD (overlap) ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="-24dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ===== INFO SISA CUTI ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_info_cuti"
                    android:padding="12dp"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_red"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/txtSisaCuti"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sisa Cuti Tersedia"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#C62828"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8 dari 12 hari cuti tahunan"
                            android:textSize="11sp"
                            android:textColor="#E57373"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== TANGGAL MULAI ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TANGGAL MULAI"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#B71C1C"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#FAFAFA"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1.5dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/calender"
                            app:tint="#C62828"
                            android:layout_marginEnd="10dp"/>
                        <EditText
                            android:id="@+id/etMulai"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Pilih tanggal mulai cuti"
                            android:textSize="13sp"
                            android:textColor="#1A1A1A"
                            android:focusable="false"
                            android:background="@null"
                            android:padding="0dp"/>
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:tint="#CCCCCC"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===== TANGGAL SELESAI ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TANGGAL SELESAI"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#B71C1C"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#FAFAFA"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1.5dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/calender"
                            app:tint="#C62828"
                            android:layout_marginEnd="10dp"/>
                        <EditText
                            android:id="@+id/etSelesai"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Pilih tanggal selesai cuti"
                            android:textSize="13sp"
                            android:textColor="#1A1A1A"
                            android:focusable="false"
                            android:background="@null"
                            android:padding="0dp"/>
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:tint="#CCCCCC"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===== DURASI OTOMATIS ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/clock"
                        app:tint="#2E7D32"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Durasi Cuti"
                        android:textSize="12sp"
                        android:textColor="#2E7D32"/>

                    <TextView
                        android:id="@+id/txtDurasi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="— hari"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"/>
                </LinearLayout>

                <!-- ===== JENIS CUTI ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JENIS CUTI"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#B71C1C"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp"/>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:layout_marginBottom="14dp">

                    <!-- Cuti Tahunan (selected) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnCutiTahunan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#FFF0F0"
                        app:strokeColor="#C62828"
                        app:strokeWidth="1.5dp"
                        app:cardElevation="0dp"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="10dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                app:tint="#C62828"
                                android:layout_marginEnd="7dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cuti Tahunan"
                                android:textSize="12sp"
                                android:textColor="#C62828"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Lainnya -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnCutiLainnya"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#FAFAFA"
                        app:strokeColor="#EEEEEE"
                        app:strokeWidth="1.5dp"
                        app:cardElevation="0dp"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="10dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                app:tint="#CCCCCC"
                                android:layout_marginEnd="7dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lainnya"
                                android:textSize="12sp"
                                android:textColor="#666666"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </GridLayout>

                <!-- ===== ALASAN CUTI ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALASAN CUTI"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#B71C1C"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#FAFAFA"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1.5dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:padding="12dp">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/notes"
                            app:tint="#C62828"
                            android:layout_marginEnd="10dp"
                            android:layout_marginTop="2dp"/>
                        <EditText
                            android:id="@+id/etAlasan"
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_weight="1"
                            android:hint="Tulis alasan cuti Anda di sini..."
                            android:textSize="13sp"
                            android:textColor="#1A1A1A"
                            android:gravity="top"
                            android:background="@null"
                            android:padding="0dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===== LAMPIRAN ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAMPIRAN  (opsional)"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#B71C1C"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layoutUpload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#FAFAFA"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1.5dp"
                    app:cardElevation="0dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_red_light"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/upload"
                                app:tint="#C62828"/>
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Upload Dokumen"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#C62828"
                            android:layout_marginTop="6dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PDF, JPG, PNG maks. 5MB"
                            android:textSize="11sp"
                            android:textColor="#BBBBBB"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===== TOMBOL AJUKAN ===== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardBackgroundColor="#C62828"
                    app:cardElevation="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:padding="15dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/send"
                            app:tint="#FFFFFF"
                            android:layout_marginEnd="8dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ajukan Cuti"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===== CATATAN INFO ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:padding="10dp"
                    android:layout_marginTop="14dp">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/info"
                        app:tint="#C62828"
                        android:layout_marginEnd="8dp"
                        android:layout_marginTop="1dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pengajuan cuti akan diproses oleh atasan Anda dalam 1x24 jam kerja."
                        android:textSize="11sp"
                        android:textColor="#E57373"
                        android:lineSpacingMultiplier="1.4"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>