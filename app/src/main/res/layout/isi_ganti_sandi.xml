<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/isisgandisandi"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== HERO HEADER ===== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_header_red">

            <View
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="-40dp"
                android:layout_marginEnd="-40dp"
                android:background="@drawable/circle_white_alpha"
                android:alpha="0.08"/>

            <View
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true"
                android:layout_marginBottom="-80dp"
                android:layout_marginStart="-40dp"
                android:background="@drawable/circle_white_alpha"
                android:alpha="0.06"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#26FFFFFF"
                    app:strokeColor="#40FFFFFF"
                    app:strokeWidth="1.5dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/lock"
                        android:tint="#FFFFFF"
                        android:padding="14dp"
                        android:scaleType="fitCenter"/>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pastikan kata sandi baru kamu kuat dan aman"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

        </RelativeLayout>

        <!-- ===== CARD FORM ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-24dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KEAMANAN AKUN"
                    android:textColor="#C62828"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="16dp"/>

                <!-- Tips Box -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#FFF5F5"
                    app:strokeColor="#FFD0D0"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="top">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/info"
                            android:tint="#C62828"
                            android:layout_marginTop="1dp"
                            android:layout_marginEnd="10dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Gunakan minimal 8 karakter dengan kombinasi huruf besar, angka, dan simbol."
                            android:textColor="#7B2020"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ===== Password Lama ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kata Sandi Saat Ini"
                    android:textColor="#555555"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    android:layout_marginBottom="6dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPasswordLama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxBackgroundColor="#FAFAFA"
                    app:startIconDrawable="@drawable/lock"
                    app:startIconTint="#BBBBBB"
                    app:endIconMode="password_toggle"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPasswordLama"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Masukkan kata sandi lama"
                        android:inputType="textPassword"
                        android:textSize="14sp"
                        android:paddingStart="4dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    android:layout_marginBottom="16dp"/>

                <!-- ===== Password Baru ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kata Sandi Baru"
                    android:textColor="#555555"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    android:layout_marginBottom="6dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPasswordBaru"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxBackgroundColor="#FAFAFA"
                    app:startIconDrawable="@drawable/key"
                    app:startIconTint="#BBBBBB"
                    app:endIconMode="password_toggle"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPasswordBaru"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Buat kata sandi baru"
                        android:inputType="textPassword"
                        android:textSize="14sp"
                        android:paddingStart="4dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Strength Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:id="@+id/strengthBar1"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="#ECEDEF"/>

                    <View
                        android:id="@+id/strengthBar2"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="#ECEDEF"/>

                    <View
                        android:id="@+id/strengthBar3"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="#ECEDEF"/>

                    <View
                        android:id="@+id/strengthBar4"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="#ECEDEF"/>

                    <TextView
                        android:id="@+id/tvStrengthLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:minWidth="60dp"
                        android:gravity="end"/>

                </LinearLayout>

                <!-- ===== Konfirmasi Password ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Konfirmasi Kata Sandi"
                    android:textColor="#555555"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    android:layout_marginBottom="6dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilKonfirmasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxBackgroundColor="#FAFAFA"
                    app:startIconDrawable="@drawable/check"
                    app:startIconTint="#BBBBBB"
                    app:endIconMode="password_toggle"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etKonfirmasi"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Ulangi kata sandi baru"
                        android:inputType="textPassword"
                        android:textSize="14sp"
                        android:paddingStart="4dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvMatchMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:layout_marginBottom="24dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"/>

                <!-- ===== Tombol Simpan ===== -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGantiSandi"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Simpan Perubahan"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/save"
                    app:iconGravity="textStart"
                    app:iconTint="#FFFFFF"
                    app:iconPadding="8dp"
                    android:backgroundTint="#C62828"
                    app:rippleColor="#B71C1C"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>