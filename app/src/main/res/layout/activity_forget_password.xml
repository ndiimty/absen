<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ═══════════════════════════════════════════════════
             RED HEADER BANNER
        ════════════════════════════════════════════════════ -->

        <!-- Decorative circle accent kiri -->
        <View
            android:id="@+id/headerBanner"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:background="#CC0000"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/circleAccentLeft"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:background="@drawable/shape_circle_white_alpha"
            android:layout_marginStart="-50dp"
            android:layout_marginTop="-50dp"
            android:alpha="0.08"
            app:layout_constraintTop_toTopOf="@id/headerBanner"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Decorative circle accent kanan -->
        <View
            android:id="@+id/circleAccentRight"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/shape_circle_white_alpha"
            android:layout_marginEnd="-30dp"
            android:layout_marginTop="-20dp"
            android:alpha="0.06"
            app:layout_constraintTop_toTopOf="@id/headerBanner"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ═══════════════════════════════════════════════════
             LOGO — melayang di antara banner dan konten
        ════════════════════════════════════════════════════ -->
        <View
            android:id="@+id/logoRing"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:background="@drawable/shape_circle_white_border_red"
            android:layout_marginTop="-46dp"
            android:elevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/headerBanner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/logoForgot"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/logo"
            android:scaleType="centerCrop"
            android:elevation="8dp"
            app:layout_constraintTop_toTopOf="@id/logoRing"
            app:layout_constraintBottom_toBottomOf="@id/logoRing"
            app:layout_constraintStart_toStartOf="@id/logoRing"
            app:layout_constraintEnd_toEndOf="@id/logoRing" />

        <!-- ═══════════════════════════════════════════════════
             JUDUL & SUBJUDUL
        ════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lupa Password?"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginTop="16dp"
            android:fontFamily="serif"
            app:layout_constraintTop_toBottomOf="@id/logoRing"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ═══════════════════════════════════════════════════
             INFO CARD
        ════════════════════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#FFF5F5"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <!-- Ikon info merah kecil -->
                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="✉"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:textColor="#CC0000"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tvInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Masukkan email Anda, kami akan mengirimkan link verifikasi untuk mereset password."
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═══════════════════════════════════════════════════
             LABEL EMAIL
        ════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/labelEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="ALAMAT EMAIL"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#CC0000"
            android:letterSpacing="0.12"
            android:layout_marginTop="20dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="6dp"
            app:layout_constraintTop_toBottomOf="@id/cardInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- INPUT EMAIL -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tiEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxBackgroundColor="#FAFAFA"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="#F0F0F0"
            app:boxStrokeWidth="1.5dp"
            app:startIconDrawable="@drawable/mail"
            app:startIconTint="#CCCCCC"
            android:hint=""
            app:layout_constraintTop_toBottomOf="@id/labelEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:inputType="textEmailAddress"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:hint="nama@email.com"
                android:textColorHint="#BBBBBB" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ═══════════════════════════════════════════════════
             TOMBOL KIRIM EMAIL
        ════════════════════════════════════════════════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendEmail"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:text="KIRIM EMAIL RESET"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:backgroundTint="#CC0000"
            app:cornerRadius="27dp"
            app:icon="@drawable/mail"
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:elevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/tiEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ═══════════════════════════════════════════════════
             LINK KEMBALI KE LOGIN
        ════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/tvBackLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Kembali ke Login"
            android:textSize="13sp"
            android:textColor="#CC0000"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/btnSendEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ═══════════════════════════════════════════════════
             SECURE BADGE (Bottom)
        ════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/secureTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            app:layout_constraintTop_toBottomOf="@id/tvBackLogin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <View
                android:layout_width="24dp"
                android:layout_height="2dp"
                android:background="#CC0000"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SECURE RESET"
                android:textSize="9sp"
                android:textColor="#CCCCCC"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <View
                android:layout_width="24dp"
                android:layout_height="2dp"
                android:background="#CC0000"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>