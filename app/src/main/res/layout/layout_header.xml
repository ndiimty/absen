<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/headerLayout"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_header_red"
    android:paddingHorizontal="16dp">

    <!-- Lingkaran dekoratif kanan -->
    <View
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/circle_white_alpha"
        android:alpha="0.08"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="-20dp"/>

    <!-- Tombol Menu -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnMenuWrapper"
        android:layout_width="38dp"
        android:layout_height="38dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="#26FFFFFF"
        app:strokeColor="#30FFFFFF"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/menu"
            android:tint="#FFFFFF"
            android:padding="9dp"
            android:scaleType="fitCenter"/>

    </com.google.android.material.card.MaterialCardView>

    <!-- Judul -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dashboard"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Notifikasi (opsional, bisa dihapus) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnNotifWrapper"
        android:layout_width="38dp"
        android:layout_height="38dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="#26FFFFFF"
        app:strokeColor="#30FFFFFF"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/btnNotif"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/notif"
            android:tint="#FFFFFF"
            android:padding="9dp"
            android:scaleType="fitCenter"/>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>