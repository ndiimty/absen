<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== HEADER ===== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_red"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="48dp">

            <!-- Lingkaran dekoratif -->
            <View
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/bg_circle_deco"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="-40dp"
                android:layout_marginEnd="-40dp"/>

            <!-- Top bar: tombol back + judul -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/btnBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_white_alpha"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">
                </LinearLayout>

                <!-- Placeholder agar judul benar-benar di tengah -->
                <View
                    android:layout_width="36dp"
                    android:layout_height="36dp"/>
            </LinearLayout>

            <!-- Ikon dekoratif di bawah judul -->
            <LinearLayout
                android:id="@+id/iconSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_below="@id/topBar"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_icon_white_alpha"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/izin"
                        app:tint="#FFFFFF"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Isi formulir pengajuan izin di bawah ini"
                    android:textColor="#FFCCCC"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

        </RelativeLayout>

        <!-- ===== FORM CARD (overlap ke header) ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="-24dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ===== LABEL TANGGAL ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TANGGAL IZIN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#B71C1C"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp"/>

                <!-- Input Tanggal -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#FAFAFA"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1.5dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            app:tint="#C62828"
                            android:src="@drawable/calender"
                            android:layout_marginEnd="10dp"/>

                        <EditText
                            android:id="@+id/etTanggal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Pilih tanggal izin"
                            android:textSize="13sp"
                            android:textColor="#1A1A1A"
                            android:focusable="false"
                            android:background="@null"
                            android:padding="0dp"/>

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:tint="#CCCCCC"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===== LABEL JENIS IZIN ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JENIS IZIN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#B71C1C"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp"/>

                <!-- Grid 2x2 pilihan jenis izin -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:layout_marginBottom="14dp">

                    <!-- Izin Pribadi (selected) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnIzinPribadi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:layout_margin="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#FFF0F0"
                        app:strokeColor="#C62828"
                        app:strokeWidth="1.5dp"
                        app:cardElevation="0dp"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="10dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                app:tint="#C62828"
                                android:layout_marginEnd="7dp"/>
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Izin Pribadi"
                                android:textSize="12sp"
                                android:textColor="#C62828"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Izin Keluarga -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnIzinKeluarga"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:layout_margin="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#FAFAFA"
                        app:strokeColor="#EEEEEE"
                        app:strokeWidth="1.5dp"
                        app:cardElevation="0dp"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="10dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                app:tint="#CCCCCC"
                                android:layout_marginEnd="7dp"/>
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Izin Keluarga"
                                android:textSize="12sp"
                                android:textColor="#666666"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Izin Dinas -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnIzinDinas"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:layout_margin="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#FAFAFA"
                        app:strokeColor="#EEEEEE"
                        app:strokeWidth="1.5dp"
                        app:cardElevation="0dp"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="10dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                app:tint="#CCCCCC"
                                android:layout_marginEnd="7dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Izin Dinas"
                                android:textSize="12sp"
                                android:textColor="#666666"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Lainnya -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnIzinLainnya"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:layout_margin="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#FAFAFA"
                        app:strokeColor="#EEEEEE"
                        app:strokeWidth="1.5dp"
                        app:cardElevation="0dp"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="10dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                app:tint="#CCCCCC"
                                android:layout_marginEnd="7dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lainnya"
                                android:textSize="12sp"
                                android:textColor="#666666"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </GridLayout>

                <!-- ===== LABEL KETERANGAN ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KETERANGAN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#B71C1C"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp"/>

                <!-- Input Keterangan -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#FAFAFA"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1.5dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/notes"
                            app:tint="#C62828"
                            android:layout_marginEnd="10dp"
                            android:layout_marginTop="2dp"/>

                        <EditText
                            android:id="@+id/etKeterangan"
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_weight="1"
                            android:hint="Tulis keterangan izin Anda di sini..."
                            android:textSize="13sp"
                            android:textColor="#1A1A1A"
                            android:gravity="top"
                            android:background="@null"
                            android:padding="0dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===== LABEL LAMPIRAN ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAMPIRAN  (opsional)"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#B71C1C"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp"/>

                <!-- Upload area -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layoutUpload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#FAFAFA"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1.5dp"
                    app:cardElevation="0dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_red_light"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/upload"
                                app:tint="#C62828"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Upload Dokumen"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#C62828"
                            android:layout_marginTop="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PDF, JPG, PNG maks. 5MB"
                            android:textSize="11sp"
                            android:textColor="#BBBBBB"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===== TOMBOL KIRIM ===== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnKirim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardBackgroundColor="#C62828"
                    app:cardElevation="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:padding="15dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/send"
                            app:tint="#FFFFFF"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ajukan Izin"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===== CATATAN INFO ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:padding="10dp"
                    android:layout_marginTop="14dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/info"
                        app:tint="#C62828"
                        android:layout_marginEnd="8dp"
                        android:layout_marginTop="1dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pengajuan izin akan diproses oleh atasan Anda dalam 1x24 jam kerja."
                        android:textSize="11sp"
                        android:textColor="#E57373"
                        android:lineSpacingMultiplier="1.4"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>