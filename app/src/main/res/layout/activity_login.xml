<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ═══════════════════════════════════════════════════
             RED HEADER BANNER
        ════════════════════════════════════════════════════ -->
        <View
            android:id="@+id/headerBanner"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:background="#CC0000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Decorative circle accent kiri -->
        <View
            android:id="@+id/circleAccentLeft"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:background="@drawable/shape_circle_white_alpha"
            android:layout_marginStart="-50dp"
            android:layout_marginTop="-50dp"
            app:layout_constraintTop_toTopOf="@id/headerBanner"
            app:layout_constraintStart_toStartOf="parent"
            android:alpha="0.08" />

        <!-- Decorative circle accent kanan -->
        <View
            android:id="@+id/circleAccentRight"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/shape_circle_white_alpha"
            android:layout_marginEnd="-30dp"
            android:layout_marginTop="-20dp"
            app:layout_constraintTop_toTopOf="@id/headerBanner"
            app:layout_constraintEnd_toEndOf="parent"
            android:alpha="0.06" />

        <!-- ═══════════════════════════════════════════════════
             LOGO — melayang di antara banner dan konten
        ════════════════════════════════════════════════════ -->
        <!-- Lingkaran putih luar (border effect) -->
        <View
            android:id="@+id/logoRing"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:background="@drawable/shape_circle_white_border_red"
            app:layout_constraintTop_toBottomOf="@id/headerBanner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="-46dp"
            android:elevation="6dp" />

        <ImageView
            android:id="@+id/logoLogin"
            android:layout_width="95dp"
            android:layout_height="95dp"
            android:src="@drawable/logo"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="@id/logoRing"
            app:layout_constraintBottom_toBottomOf="@id/logoRing"
            app:layout_constraintStart_toStartOf="@id/logoRing"
            app:layout_constraintEnd_toEndOf="@id/logoRing"
            android:elevation="8dp" />

        <!-- ═══════════════════════════════════════════════════
             JUDUL & SUBJUDUL
        ════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selamat Datang"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/logoRing"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Masuk ke akun Anda untuk melanjutkan"
            android:textSize="13sp"
            android:textColor="#999999"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvWelcome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ═══════════════════════════════════════════════════
             LABEL EMAIL
        ════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/labelEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="EMAIL"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#CC0000"
            android:letterSpacing="0.12"
            android:layout_marginTop="28dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="6dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- INPUT EMAIL -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tiEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxBackgroundColor="#FAFAFA"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="#F0F0F0"
            app:boxStrokeWidth="1.5dp"
            app:startIconDrawable="@drawable/mail"
            android:hint=""
            app:layout_constraintTop_toBottomOf="@id/labelEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:inputType="textEmailAddress"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:hint="nama@email.com"
                android:textColorHint="#BBBBBB" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ═══════════════════════════════════════════════════
             LABEL PASSWORD
        ════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/labelPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="PASSWORD"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#CC0000"
            android:letterSpacing="0.12"
            android:layout_marginTop="16dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="6dp"
            app:layout_constraintTop_toBottomOf="@id/tiEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- INPUT PASSWORD -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tiPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxBackgroundColor="#FAFAFA"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="#F0F0F0"
            app:boxStrokeWidth="1.5dp"
            app:startIconDrawable="@drawable/lock"
            app:endIconMode="password_toggle"
            android:hint=""
            app:layout_constraintTop_toBottomOf="@id/labelPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:inputType="textPassword"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:hint="Masukkan password"
                android:textColorHint="#BBBBBB" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ═══════════════════════════════════════════════════
             REMEMBER ME + LUPA PASSWORD
        ════════════════════════════════════════════════════ -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbrememberme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingat Saya"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginTop="12dp"
            android:layout_marginStart="24dp"
            app:useMaterialThemeColors="false"
            app:buttonTint="#CC0000"
            app:layout_constraintTop_toBottomOf="@id/tiPassword"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvSignUpLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lupa Password?"
            android:textColor="#CC0000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="24dp"
            app:layout_constraintBaseline_toBaselineOf="@id/cbrememberme"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ═══════════════════════════════════════════════════
             TOMBOL LOGIN
        ════════════════════════════════════════════════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:text="LOGIN"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:backgroundTint="#CC0000"
            app:cornerRadius="27dp"
            app:icon="@drawable/login"
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:layout_constraintTop_toBottomOf="@id/cbrememberme"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:elevation="4dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>

