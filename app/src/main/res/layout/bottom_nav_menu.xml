<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <View
        android:id="@+id/navBackground"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@drawable/shape_navbar_bg"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- HOME -->
    <LinearLayout
        android:id="@+id/navHomeWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:elevation="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/navCalendarWrapper"
        app:layout_constraintBottom_toBottomOf="@id/navBackground"
        app:layout_constraintTop_toTopOf="@id/navBackground"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintHorizontal_chainStyle="spread">

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/nav_home"
            android:contentDescription="Home"
            app:tint="#CC0000" />

        <TextView
            android:id="@+id/tvNavHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textSize="9sp"
            android:textColor="#CC0000"
            android:textStyle="bold"
            android:layout_marginTop="3dp"
            android:letterSpacing="0.05" />

        <View
            android:id="@+id/navDotIndicator"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:background="@drawable/shape_dot_red"
            android:layout_marginTop="2dp"
            android:visibility="visible" />
    </LinearLayout>

    <!-- CALENDAR -->
    <LinearLayout
        android:id="@+id/navCalendarWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:elevation="14dp"
        app:layout_constraintStart_toEndOf="@id/navHomeWrapper"
        app:layout_constraintEnd_toStartOf="@id/cameraRingOuter"
        app:layout_constraintBottom_toBottomOf="@id/navBackground"
        app:layout_constraintTop_toTopOf="@id/navBackground"
        app:layout_constraintHorizontal_weight="1">

        <ImageView
            android:id="@+id/navCalendar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/calender"
            android:contentDescription="Kalender"
            app:tint="#AAAAAA" />

        <TextView
            android:id="@+id/tvNavCalendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kalender"
            android:textSize="9sp"
            android:textColor="#AAAAAA"
            android:layout_marginTop="3dp"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <!-- CAMERA -->
    <View
        android:id="@+id/cameraRingOuter"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/shape_circle_white_solid"
        android:elevation="14dp"
        app:layout_constraintStart_toEndOf="@id/navCalendarWrapper"
        app:layout_constraintEnd_toStartOf="@id/navReportWrapper"
        app:layout_constraintBottom_toBottomOf="@id/navBackground"
        app:layout_constraintTop_toTopOf="@id/navBackground"
        android:layout_marginBottom="20dp"
        app:layout_constraintHorizontal_weight="1" />

    <View
        android:id="@+id/cameraCircle"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/shape_circle_red"
        android:elevation="15dp"
        app:layout_constraintTop_toTopOf="@id/cameraRingOuter"
        app:layout_constraintBottom_toBottomOf="@id/cameraRingOuter"
        app:layout_constraintStart_toStartOf="@id/cameraRingOuter"
        app:layout_constraintEnd_toEndOf="@id/cameraRingOuter" />

    <LinearLayout
        android:id="@+id/navCameraWrapper"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:orientation="vertical"
        android:gravity="center"
        android:elevation="16dp"
        app:layout_constraintTop_toTopOf="@id/cameraRingOuter"
        app:layout_constraintBottom_toBottomOf="@id/cameraRingOuter"
        app:layout_constraintStart_toStartOf="@id/cameraRingOuter"
        app:layout_constraintEnd_toEndOf="@id/cameraRingOuter">

        <ImageView
            android:id="@+id/navCamera"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/camera"
            android:contentDescription="Buka Kamera"
            android:padding="0dp"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Camera"
            android:textSize="8sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <!-- REPORT -->
    <LinearLayout
        android:id="@+id/navReportWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:elevation="14dp"
        app:layout_constraintStart_toEndOf="@id/cameraRingOuter"
        app:layout_constraintEnd_toStartOf="@id/navProfileWrapper"
        app:layout_constraintBottom_toBottomOf="@id/navBackground"
        app:layout_constraintTop_toTopOf="@id/navBackground"
        app:layout_constraintHorizontal_weight="1">

        <ImageView
            android:id="@+id/navReport"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/report"
            android:contentDescription="Laporan"
            app:tint="#AAAAAA" />

        <TextView
            android:id="@+id/tvNavReport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Laporan"
            android:textSize="9sp"
            android:textColor="#AAAAAA"
            android:layout_marginTop="3dp"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <!-- PROFILE -->
    <LinearLayout
        android:id="@+id/navProfileWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="14dp"
        android:gravity="center"
        app:layout_constraintStart_toEndOf="@id/navReportWrapper"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/navBackground"
        app:layout_constraintTop_toTopOf="@id/navBackground"
        app:layout_constraintHorizontal_weight="1">

        <ImageView
            android:id="@+id/navProfile"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/profil"
            android:contentDescription="Profil"
            app:tint="#AAAAAA" />

        <TextView
            android:id="@+id/tvNavProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profil"
            android:textSize="9sp"
            android:textColor="#AAAAAA"
            android:layout_marginTop="3dp"
            android:letterSpacing="0.05" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>