<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- KONTEN HALAMAN -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>


    <!-- SIDEBAR -->
    <LinearLayout
        android:id="@+id/customDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#F7F7F7"
        android:orientation="vertical">

        <!-- HEADER MERAH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:background="#D92020"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="22dp"
                app:cardBackgroundColor="#30FFFFFF"
                app:strokeWidth="1dp"
                app:strokeColor="#80FFFFFF"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:src="@drawable/person"
                    android:tint="#FFFFFF"/>

            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:id="@+id/tvNamaUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Nama Pengguna"
                android:textColor="#FFFFFF"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tvEmailUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="pengguna@email.com"
                android:textColor="#D8FFFFFF"
                android:textSize="11sp"/>

        </LinearLayout>


        <!-- MENU -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MENU"
                android:textSize="9sp"
                android:textColor="#A8A8A8"
                android:letterSpacing="0.2"/>

            <!-- Pengaturan -->
            <LinearLayout
                android:id="@+id/navItemPengaturan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/setting"
                    android:tint="#666666"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Pengaturan"
                    android:textSize="13sp"/>
            </LinearLayout>


            <!-- Ganti Sandi -->
            <LinearLayout
                android:id="@+id/navItemPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_password"
                    android:tint="#666666"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Ganti Sandi"
                    android:textSize="13sp"/>

            </LinearLayout>


            <!-- Tema -->
            <LinearLayout
                android:id="@+id/navItemTema"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_theme"
                    android:tint="#666666"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Tema"
                    android:textSize="13sp"/>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/down"
                    android:tint="#999999"/>

            </LinearLayout>

        </LinearLayout>


        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EAEAEA"/>


        <!-- Logout -->
        <LinearLayout
            android:id="@+id/navItemLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/logout"
                android:tint="#D92020"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Logout"
                android:textColor="#D92020"
                android:textSize="13sp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>